# Browser-facing API endpoint for the local web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Source synchronization limits. Only approved hosts and paths are accepted.
SOURCE_TIMEOUT_SECONDS=15
SOURCE_MAX_BYTES=2097152

# Optional OpenAI-compatible chat-completions provider. Leave blank for deterministic demo mode.
# For a local DeepSeek secret, put the key in .deepseek_api_key and mount it through an ignored compose.override.yaml.
MODEL_BASE_URL=
MODEL_NAME=

RESEARCH_MAX_EVIDENCE=6
RESEARCH_MODEL_TIMEOUT_SECONDS=20
RESEARCH_MAX_OUTPUT_TOKENS=256
